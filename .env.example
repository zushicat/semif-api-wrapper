API_KEY=
USE_API_KEY=false
HF_HOME=/Volumes/Expansion/_models/lm-studio/models

# SemIf backend (required; abort startup when missing)
SEMIF_MODEL=/Volumes/Expansion/_models/lm-studio/models/lmstudio-community/Qwen3.5-4B-MLX-4bit
SEMIF_REVISION=lmstudio-community/Qwen3.5-4B-MLX-4bit
SEMIF_BACKEND=mlx
SEMIF_MODE=direct
SEMIF_MAX_TOKENS=4096
SEMIF_MLX_BITS=
SEMIF_MLX_CACHE_LIMIT_MIB=
SEMIF_PRELOAD=true

# Jev response surface
REPORTED_MODEL_ID=
ALLOWED_MODELS=

# Note: HF_HOME only matters when models resolve through the HF hub cache; a local SEMIF_MODEL path loads directly.
